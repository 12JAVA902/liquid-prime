# Supabase / Lovable Cloud (publishable values only — safe for the browser)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Private API keys are NOT stored here. They live as server-side edge function
# secrets (e.g. YOUTUBE_API_KEY, TMDB_API_KEY, LOVABLE_API_KEY) and are only
# read inside supabase/functions/*.
